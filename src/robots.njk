---
permalink: /robots.txt
eleventyExcludeFromCollections: true
---
{%- set published = locales | publishable(domains) -%}
{%- if build.indexable and published | length -%}
User-agent: *
Allow: /
Disallow: /concept-gate2/

# AI assistants are allowed on purpose: being citable is the point of AEO/GEO.
User-agent: GPTBot
Allow: /
User-agent: ClaudeBot
Allow: /
User-agent: PerplexityBot
Allow: /
User-agent: Google-Extended
Allow: /

{# One sitemap per host. Both hosts must be verified in Search Console before
   cross-submission is accepted. #}
{%- if domains.international %}
Sitemap: {{ domains.international }}/sitemap.xml
{%- endif %}
{%- if domains.he %}
Sitemap: {{ domains.he }}/sitemap-he.xml
{%- endif %}
{%- else -%}
# Not a production build, or no canonical origin is configured.
User-agent: *
Disallow: /
{%- endif -%}
