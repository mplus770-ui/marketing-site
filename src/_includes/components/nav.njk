{% set homeHref = (loc | absUrl(domains)) or loc.buildPath %}
{% set sectionBase = '' if isHome else homeHref %}
<header class="nav">
  <div class="nav-in">
    <a class="nav-logo" href="{{ homeHref }}" aria-label="{{ strings.nav.home }}">
      <svg width="42" height="42" aria-hidden="true" focusable="false"><use href="#mark"/></svg>
      <span class="wm-lock"><span class="wm">{{ site.brand }} <b>AI</b></span><span class="wm-studio">DIGITAL EXPERIENCE STUDIO</span></span>
    </a>
    {% if loc.ready %}
    <ul class="nav-links">
      <li><a href="{{ sectionBase }}#work">{{ strings.nav.work }}</a></li>
      <li><a href="{{ sectionBase }}#method">{{ strings.nav.method }}</a></li>
      <li><a href="{{ sectionBase }}#offer">{{ strings.nav.offer }}</a></li>
      <li><a href="{{ sectionBase }}#vision">{{ strings.nav.vision }}</a></li>
      <li><a href="{{ sectionBase }}#brief">{{ strings.nav.contact }}</a></li>
    </ul>
    {% endif %}
    <div class="nav-right">
      <button class="lang-btn" type="button" id="langBtn" aria-haspopup="dialog" aria-expanded="false" aria-label="{{ strings.nav.language }}">
        <svg width="14" height="14" aria-hidden="true" focusable="false"><use href="#i-globe"/></svg>
        <span aria-hidden="true">{{ loc.code | upper }}</span>
      </button>
      {% if loc.ready %}<a class="btn btn-primary btn-sm" href="{{ sectionBase }}#brief">{{ strings.nav.cta }}</a>{% endif %}
      <button class="burger" type="button" id="burger" aria-expanded="false" aria-controls="sheet" aria-label="{{ strings.nav.menu }}">
        <i></i><i></i><i></i>
      </button>
    </div>
  </div>
</header>

<div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-label="{{ strings.nav.menu }}" hidden>
  <div class="sheet-top">
    <span class="nav-logo"><svg width="28" height="28" aria-hidden="true" focusable="false"><use href="#mark"/></svg></span>
    <button class="lang-btn" type="button" id="sheetClose" aria-label="{{ strings.nav.close }}">✕</button>
  </div>
  <nav class="sheet-nav" aria-label="{{ strings.nav.menu }}">
    <ul>
      {% if loc.ready %}
      <li><a href="{{ sectionBase }}#work">{{ strings.nav.work }}</a></li>
      <li><a href="{{ sectionBase }}#method">{{ strings.nav.method }}</a></li>
      <li><a href="{{ sectionBase }}#offer">{{ strings.nav.offer }}</a></li>
      <li><a href="{{ sectionBase }}#vision">{{ strings.nav.vision }}</a></li>
      <li><a href="{{ sectionBase }}#brief">{{ strings.nav.contact }}</a></li>
      {% endif %}
      {% for l in locales %}{% if l.ready %}{% set localPage = l.buildPath ~ (pageSlug ~ '/' if pageSlug else '') %}<li><a href="{{ (l | absPageUrl(domains, pageSlug or '')) or localPage }}" lang="{{ l.code }}" hreflang="{{ l.hreflang }}">{{ l.endonym }}</a></li>{% endif %}{% endfor %}
    </ul>
  </nav>
  {% if loc.ready %}
  <div class="sheet-foot">
    {% set waSheet = site.whatsapp | waLink(strings.contact.waPrefill) %}
    {% if waSheet %}
      <a class="btn btn-primary u-full" href="{{ waSheet }}" rel="noopener">
        <svg width="18" height="18" aria-hidden="true" focusable="false"><use href="#i-wa"/></svg>{{ strings.hero.ctaSecondary }}</a>
    {% else %}
      <span class="inert u-full-center">
        <svg width="18" height="18" aria-hidden="true" focusable="false"><use href="#i-wa"/></svg>{{ strings.brief.unavailable }}</span>
    {% endif %}
  </div>
  {% endif %}
</div>
