<footer class="foot">
  <div class="wide foot-in">
    <div class="foot-brand">
      <svg width="26" height="26" aria-hidden="true" focusable="false"><use href="#mark"/></svg>
      <div>
        <div class="foot-brand-name">{{ site.brand }}</div>
        <div class="xs">{{ strings.footer.tagline }}</div>
      </div>
    </div>
    <nav class="foot-legal" aria-label="{{ strings.footer.legalNav }}">
      <a href="{{ (loc | absPageUrl(domains, 'privacy')) or (loc.buildPath ~ 'privacy/') }}">{{ strings.footer.privacy }}</a>
      <a href="{{ (loc | absPageUrl(domains, 'accessibility')) or (loc.buildPath ~ 'accessibility/') }}">{{ strings.footer.accessibility }}</a>
      <a href="{{ (loc | absPageUrl(domains, 'terms')) or (loc.buildPath ~ 'terms/') }}">{{ strings.footer.terms }}</a>
    </nav>
    <div class="foot-contact">
      {% if site.email %}<a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endif %}
      {% if site.whatsapp %}<a href="{{ site.whatsapp | waLink(strings.contact.waPrefill) }}" rel="noopener">{{ site.whatsappDisplay }}</a>{% endif %}
    </div>
    <div class="foot-bottom">
      <nav class="foot-langs" aria-label="{{ strings.nav.language }}">
        {% for l in locales %}{% if l.ready %}{% set localPage = l.buildPath ~ (pageSlug ~ '/' if pageSlug else '') %}<a href="{{ (l | absPageUrl(domains, pageSlug or '')) or localPage }}" lang="{{ l.code }}" hreflang="{{ l.hreflang }}">{{ l.endonym }}</a>{% endif %}{% endfor %}
      </nav>
      <p class="xs">© 2026 {{ site.brand }}. {{ strings.footer.rights }}</p>
    </div>
  </div>
</footer>
