<footer class="foot">
  <div class="wide foot-in">
    <div style="display:flex;align-items:center;gap:11px">
      <svg width="26" height="26" aria-hidden="true" focusable="false"><use href="#mark"/></svg>
      <div>
        <div style="font-family:var(--font-display);font-weight:600;letter-spacing:.14em;color:var(--z-text-hi)">{{ site.brand }}</div>
        <div class="xs">{{ strings.footer.tagline }}</div>
      </div>
    </div>
    <nav class="foot-langs" aria-label="{{ strings.footer.nav }}">
      {% for l in locales %}
        {% if l.ready %}<a href="{{ l.path }}" lang="{{ l.code }}" hreflang="{{ l.hreflang }}">{{ l.endonym }}</a>
        {% else %}<span lang="{{ l.code }}" title="pending translation QA">{{ l.endonym }}</span>{% endif %}
      {% endfor %}
    </nav>
    <p class="xs">
      {% if site.email %}<a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endif %}
      {% if site.whatsapp %}<span aria-hidden="true"> · </span><bdi>{{ site.whatsappDisplay }}</bdi>{% endif %}
      <br>
      {% if site.legalEntity %}© {{ site.legalEntity }}. {{ strings.footer.rights }}
      {% else %}{{ strings.footer.pending }}{% endif %}
    </p>
  </div>
</footer>
