<footer class="foot">
  <div class="wide foot-in">
    <div class="foot-brand">
      <svg width="26" height="26" aria-hidden="true" focusable="false"><use href="#mark"/></svg>
      <div>
        <div class="foot-brand-name">{{ site.brand }}</div>
        <div class="xs">{{ strings.footer.tagline }}</div>
      </div>
    </div>
    <nav class="foot-langs" aria-label="{{ strings.footer.nav }}">
      {% for l in locales %}
        {% if l.ready %}<a href="{{ (l | absUrl(domains)) or l.buildPath }}" lang="{{ l.code }}" hreflang="{{ l.hreflang }}">{{ l.endonym }}</a>
        {% else %}<span lang="{{ l.code }}" aria-disabled="true" title="{{ strings.footer.langPending }}">{{ l.endonym }}</span>{% endif %}
      {% endfor %}
    </nav>
    <p class="xs foot-contact">
      {% if site.email %}<a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endif %}
      {% if site.whatsapp %}<a href="{{ site.whatsapp | waLink(strings.contact.waPrefill) }}" rel="noopener">{{ site.whatsappDisplay }}</a>{% endif %}
      <br>
      {% if site.legalEntity %}© {{ site.legalEntity }}. {{ strings.footer.rights }}
      {% else %}{{ strings.footer.pending }}{% endif %}
    </p>
  </div>
</footer>
