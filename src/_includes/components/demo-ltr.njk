    <g class="m-fill" style="animation-delay:2.2s">
      <rect x="32" y="452" width="336" height="1" fill="rgba(244,241,234,.09)"/>
      <text x="32" y="472" fill="#6E7F76" font-family="Assistant,sans-serif" font-size="8.5">© Galilee Estate · Visit us Thursday to Saturday</text>
    </g>

    <!-- luminous sweep -->
    <rect class="m-lum m-motion-only" x="10" y="10" width="380" height="150" fill="url(#gLum)"/>
  </g>


  <rect class="m-trace" x="10" y="10" width="380" height="480" rx="15" fill="none" stroke="#34E39B" stroke-width="1.3" opacity=".8"/>
</svg>
