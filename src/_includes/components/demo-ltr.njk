    <g class="m-fill" style="animation-delay:1.36s" clip-path="url(#dHeroClip)">
      <rect x="10" y="54" width="380" height="200" fill="url(#dSky)"/>
      <rect x="10" y="54" width="380" height="200" fill="url(#dSun)"/>
      <path d="M10 196c58-30 104-14 152-34s86-40 132-22c40 16 68 10 96-4v118H10Z" fill="url(#dHillC)"/>
      <path d="M10 216c52-24 98-8 148-26 46-16 84-30 128-14 38 14 66 12 104 2v76H10Z" fill="#0A4030"/>
      <path d="M10 236c60-22 112-6 160-20 44-13 86-22 126-10 36 11 66 10 94 2v46H10Z" fill="url(#dHillA)" opacity=".92"/>
      <g opacity=".22" stroke="#8FF3C8" stroke-width=".7">
        <path d="M34 254l26-20M74 254l26-20M114 254l26-20M154 254l26-20M194 254l26-20M234 254l26-20M274 254l26-20M314 254l26-20"/>
      </g>
      <rect x="10" y="54" width="380" height="200" fill="url(#dScrim)"/>
    </g>

    <!-- HERO COPY -->
    <g class="m-fill" style="animation-delay:1.56s">
      <text x="32" y="112" fill="#E4B363" font-family="Assistant,sans-serif" font-size="8.5" font-weight="700" letter-spacing="2.2">GALILEE · EST. 1998</text>
      <text x="32" y="150" fill="#F7F4ED" font-family="Fraunces,Georgia,serif" font-size="30" font-weight="600" letter-spacing="-.6">Wine from a</text>
      <text x="32" y="182" fill="#F7F4ED" font-family="Fraunces,Georgia,serif" font-size="30" font-weight="600" letter-spacing="-.6">single hillside.</text>
      <text x="32" y="206" fill="#C6D3C9" font-family="Assistant,sans-serif" font-size="10.5">Small harvests, pressed and bottled on the estate.</text>
    </g>
    <g class="m-fill" style="animation-delay:1.74s">
      <rect x="32" y="218" width="118" height="28" rx="14" fill="#34E39B"/>
      <text x="48" y="236" fill="#04150F" font-family="Assistant,sans-serif" font-size="10.5" font-weight="700">Book a tasting</text>
      <rect x="160" y="218" width="94" height="28" rx="14" fill="none" stroke="rgba(244,241,234,.28)"/>
      <text x="176" y="236" fill="#E6E2D8" font-family="Assistant,sans-serif" font-size="10.5" font-weight="600">Our wines</text>
    </g>

    <!-- SECTION -->
    <g class="m-fill" style="animation-delay:1.92s">
      <rect x="32" y="278" width="26" height="1.4" fill="#34E39B"/>
      <text x="32" y="300" fill="#E4B363" font-family="Assistant,sans-serif" font-size="8.5" font-weight="700" letter-spacing="2.2">THE VINEYARD</text>
      <text x="32" y="322" fill="#F4F1EA" font-family="Fraunces,Georgia,serif" font-size="17" font-weight="600">Three hectares, one slope</text>
    </g>

    <!-- CARDS -->
    <g class="m-fill" style="animation-delay:2.06s">
      <g><rect x="32" y="338" width="106" height="62" rx="7" fill="url(#dCard1)"/>
        <path d="M32 380c22-12 36-4 54-12s34-12 52-4v29a7 7 0 0 1-7 7H39a7 7 0 0 1-7-7Z" fill="#083527" opacity=".55"/>
        <rect x="32" y="338" width="106" height="1.2" rx=".6" fill="#34E39B" opacity=".5"/>
        <text x="32" y="416" fill="#F4F1EA" font-family="Assistant,sans-serif" font-size="9.5" font-weight="700">The slope</text>
        <text x="32" y="430" fill="#8FA69A" font-family="Assistant,sans-serif" font-size="8.5">Limestone, 620m</text></g>
      <g><rect x="147" y="338" width="106" height="62" rx="7" fill="url(#dCard2)"/>
        <circle cx="200" cy="366" r="17" fill="#E4B363" opacity=".28"/><circle cx="200" cy="366" r="9" fill="#F3D9A6" opacity=".4"/>
        <rect x="147" y="338" width="106" height="1.2" rx=".6" fill="#34E39B" opacity=".5"/>
        <text x="147" y="416" fill="#F4F1EA" font-family="Assistant,sans-serif" font-size="9.5" font-weight="700">The harvest</text>
        <text x="147" y="430" fill="#8FA69A" font-family="Assistant,sans-serif" font-size="8.5">By hand, at dawn</text></g>
      <g><rect x="262" y="338" width="106" height="62" rx="7" fill="url(#dCard3)"/>
        <rect x="286" y="352" width="12" height="34" rx="5" fill="#0F5E44"/><rect x="304" y="346" width="12" height="40" rx="5" fill="#136B4E"/><rect x="322" y="356" width="12" height="30" rx="5" fill="#0D5340"/>
        <rect x="262" y="338" width="106" height="1.2" rx=".6" fill="#34E39B" opacity=".5"/>
        <text x="262" y="416" fill="#F4F1EA" font-family="Assistant,sans-serif" font-size="9.5" font-weight="700">The cellar</text>
        <text x="262" y="430" fill="#8FA69A" font-family="Assistant,sans-serif" font-size="8.5">Bottled on site</text></g>
    </g>

