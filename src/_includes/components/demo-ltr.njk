    <linearGradient id="dPage" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#07231B"/><stop offset="1" stop-color="#051A14"/></linearGradient>
    <linearGradient id="dSky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0E4A38"/><stop offset=".55" stop-color="#0A3528"/><stop offset="1" stop-color="#06231A"/></linearGradient>
    <radialGradient id="dSun" cx=".78" cy=".16" r=".5"><stop offset="0" stop-color="#F3D9A6" stop-opacity=".55"/><stop offset=".45" stop-color="#7BE9BC" stop-opacity=".16"/><stop offset="1" stop-color="#34E39B" stop-opacity="0"/></radialGradient>
