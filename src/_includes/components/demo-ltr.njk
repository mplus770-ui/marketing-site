  <g class="m-intent m-motion-only">
    <g class="m-intent-clip"><text x="40" y="256" fill="#A9B5AC" font-family="Assistant,sans-serif" font-size="16">A family winery in the Galilee.</text></g>
    <rect class="m-cursor" x="274" y="243" width="2" height="18" fill="#34E39B"/>
  </g>

  <g clip-path="url(#dClip)">
    <!-- NAV -->
    <g class="m-fill" style="animation-delay:1.18s">
      <rect x="10" y="10" width="380" height="44" fill="#061F18"/>
      <path d="M28 24h11v4H28z" fill="#34E39B" opacity=".9"/><path d="M28 30h7v4h-7z" fill="#16A37B"/>
      <text x="46" y="33" fill="#F4F1EA" font-family="Assistant,sans-serif" font-size="10" font-weight="700" letter-spacing="1.7">GALILEE ESTATE</text>
      <text x="236" y="32" fill="#8FA69A" font-family="Assistant,sans-serif" font-size="8.5">Wines</text>
      <text x="272" y="32" fill="#8FA69A" font-family="Assistant,sans-serif" font-size="8.5">Visit</text>
      <text x="301" y="32" fill="#8FA69A" font-family="Assistant,sans-serif" font-size="8.5">Story</text>
      <rect x="333" y="21" width="42" height="21" rx="10.5" fill="#34E39B"/>
      <text x="344" y="35" fill="#04150F" font-family="Assistant,sans-serif" font-size="9" font-weight="700">Book</text>
