    <linearGradient id="dScrim" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#04150F" stop-opacity=".88"/><stop offset=".62" stop-color="#04150F" stop-opacity=".18"/><stop offset="1" stop-color="#04150F" stop-opacity="0"/></linearGradient>
    <linearGradient id="dCard1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#14775A"/><stop offset="1" stop-color="#07301F"/></linearGradient>
    <linearGradient id="dCard2" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0D5E48"/><stop offset="1" stop-color="#3A2A12"/></linearGradient>
    <linearGradient id="dCard3" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0B4A38"/><stop offset="1" stop-color="#06291E"/></linearGradient>
