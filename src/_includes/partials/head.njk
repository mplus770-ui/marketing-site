<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{{ strings.meta.title }}</title>
{% if strings.meta.description %}<meta name="description" content="{{ strings.meta.description }}">{% endif %}

{# Indexing: production + a ready locale only. Everything else is noindex. #}
{% if build.indexable and loc.ready %}
<meta name="robots" content="index,follow,max-image-preview:large">
{% else %}
<meta name="robots" content="noindex,nofollow,noarchive,nosnippet">
<meta name="googlebot" content="noindex,nofollow">
{% endif %}

{# Canonical + symmetric hreflang. Emitted only once an origin is configured;
   a relative canonical is worse than none. #}
{% if site.origin %}
<link rel="canonical" href="{{ loc.path | abs(site.origin) }}">
{% for l in locales %}{% if l.ready %}<link rel="alternate" hreflang="{{ l.hreflang }}" href="{{ l.path | abs(site.origin) }}">
{% endif %}{% endfor %}<link rel="alternate" hreflang="x-default" href="{{ '/en/' | abs(site.origin) }}">
<meta property="og:url" content="{{ loc.path | abs(site.origin) }}">
<meta property="og:image" content="{{ '/assets/brand/zohar-social-1200x630.svg' | abs(site.origin) }}">
{% endif %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.legalName }}">
<meta property="og:title" content="{{ strings.meta.title }}">
{% if strings.meta.description %}<meta property="og:description" content="{{ strings.meta.description }}">{% endif %}
<meta property="og:locale" content="{{ loc.hreflang | replace('-','_') }}">
<meta name="twitter:card" content="summary_large_image">

<link rel="icon" href="/assets/brand/zohar-favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/brand/zohar-appicon-512.svg">
<meta name="theme-color" content="#04150F">

{# Exactly two preloads: the locale's display face and its body regular. #}
{% if loc.script == "hebrew" %}
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/frankruhl-700-hebrew.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/assistant-400-hebrew.woff2" crossorigin>
{% else %}
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/fraunces-600-latin.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/assistant-400-latin.woff2" crossorigin>
{% endif %}
<link rel="stylesheet" href="/assets/gen/zohar.css">
