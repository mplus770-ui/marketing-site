<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{{ strings.meta.title }}</title>
{% if strings.meta.description %}<meta name="description" content="{{ strings.meta.description }}">{% endif %}

{% set canonical = loc | absUrl(domains) %}
{% set published = locales | publishable(domains) %}

{# A held locale is a placeholder, not a publication surface. It emits no
   canonical, no hreflang, no og:url and no og:image — only the noindex block
   below. `publishes` is the single switch for every published-surface signal. #}
{% set publishes = canonical and loc.ready %}

{# Indexing: a production build, a reviewed locale, AND a configured canonical
   origin. Any one missing and the page is noindex. A preview host can never
   become a canonical because it is never a value in domains.js. #}
{% if build.indexable and loc.ready and canonical %}
<meta name="robots" content="index,follow,max-image-preview:large">
{% else %}
<meta name="robots" content="noindex,nofollow,noarchive,nosnippet">
<meta name="googlebot" content="noindex,nofollow">
{% endif %}

{# Self-referencing canonical on this locale's OWN domain. Hebrew is never
   canonicalised to English, and the international locales are never
   canonicalised to the Hebrew host. A held locale emits none of this. #}
{% if publishes %}
<link rel="canonical" href="{{ canonical }}">
{% for l in published %}<link rel="alternate" hreflang="{{ l.hreflang }}" href="{{ l | absUrl(domains) }}">
{% endfor %}{% set xd = locales | xDefault(domains) %}{% if xd %}<link rel="alternate" hreflang="x-default" href="{{ xd }}">{% endif %}
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ (loc | originOf(domains)) + '/assets/brand/zohar-social-1200x630.png' }}">
<meta property="og:image:secure_url" content="{{ (loc | originOf(domains)) + '/assets/brand/zohar-social-1200x630.png' }}">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ strings.meta.shareImageAlt }}">
<meta name="twitter:image" content="{{ (loc | originOf(domains)) + '/assets/brand/zohar-social-1200x630.png' }}">
<meta name="twitter:image:alt" content="{{ strings.meta.shareImageAlt }}">
{% endif %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.legalName }}">
<meta property="og:title" content="{{ strings.meta.title }}">
{% if strings.meta.description %}<meta property="og:description" content="{{ strings.meta.description }}">{% endif %}
<meta property="og:locale" content="{{ loc.hreflang | replace('-','_') }}">
<meta name="twitter:card" content="summary_large_image">

<link rel="icon" href="/assets/brand/zohar-favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/brand/zohar-appicon-512.png">
<meta name="theme-color" content="#04150F">

{# Three preloads: this locale's display face, its body regular and its body
   bold. The bold face is here because the header uses it, and swapping it in
   late is what produced the only measurable layout shift on the page. #}
{% if loc.script == "hebrew" %}
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/frankruhl-700-hebrew.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/assistant-400-hebrew.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/assistant-700-hebrew.woff2" crossorigin>
{% else %}
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/fraunces-600-latin.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/assistant-400-latin.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/assistant-700-latin.woff2" crossorigin>
{% endif %}
<link rel="stylesheet" href="/assets/gen/zohar.css">
