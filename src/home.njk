---
pagination:
  data: locales
  size: 1
  alias: loc
permalink: "{{ loc.buildPath }}index.html"
layout: layouts/base.njk
---
{% if not loc.ready %}
{# ── Unpublished locale: a placeholder, never machine-translated copy and
      never another locale's strings. noindex, and absent from the sitemap. ── #}
<section class="sec">
  <div class="wrap" style="text-align:center;max-width:44rem">
    <svg width="64" height="64" style="margin-inline:auto" aria-hidden="true" focusable="false"><use href="#mark"/></svg>
    <h1 class="d2" style="margin-block:26px 14px">{{ strings.pendingLocale.title }}</h1>
    <p class="lead" style="margin-inline:auto">{{ strings.pendingLocale.body }}</p>
    <div class="hero-ctas" style="justify-content:center;margin-block-start:30px">
      <a class="btn btn-primary" href="/en/">{{ strings.pendingLocale.cta }}</a>
      <a class="btn btn-ghost" href="/">{{ strings.pendingLocale.ctaHe }}</a>
    </div>
  </div>
</section>
{% else %}

{# ══ 2 · HERO ══ #}
<section class="hero">
  <div class="wide hero-grid">
    <div class="hero-copy">
      <p class="hero-eyebrow label">{{ strings.hero.eyebrow }}</p>
      <h1 class="d1">{{ strings.hero.h1a }}<br>{{ strings.hero.h1b }}</h1>
      <p class="promise">{{ strings.hero.promise }}</p>
      <p class="lead">{{ strings.hero.lead }}</p>
      {# WhatsApp is the only conversion that actually works today, so it is
         the primary action. The brief is a preview and reads as a link. #}
      <div class="hero-ctas">
        {% set wa = site.whatsapp | waLink(strings.contact.waPrefill) %}
        {% if wa %}
          <a class="btn btn-primary btn-lg" href="{{ wa }}" rel="noopener">
            <svg width="19" height="19" aria-hidden="true" focusable="false"><use href="#i-wa"/></svg>{{ strings.hero.ctaPrimary }}</a>
        {% else %}
          <span class="inert" style="min-block-size:56px">
            <svg width="19" height="19" aria-hidden="true" focusable="false"><use href="#i-wa"/></svg>
            {{ strings.hero.ctaPrimary }} — {{ strings.brief.unavailable }}</span>
        {% endif %}
        <a class="hero-brief-link" href="#brief">{{ strings.hero.ctaSecondary }}</a>
      </div>
      <p class="hero-reassure">
        <span>{{ strings.hero.reassure1 }}</span><span aria-hidden="true">·</span>
        <span>{{ strings.hero.reassure2 }}</span><span aria-hidden="true">·</span>
        <span>{{ strings.hero.reassure3 }}</span>
      </p>
    </div>
    {# ONE controlling hero visual. The Meridian SVG demonstration used to live
       here; it now appears once, at small scale, inside the capability band so
       the two never compete for the same job. #}
    <div class="demo-wrap">
      {% include "components/hero-motion.njk" %}
      <p class="demo-cap">{{ strings.hero.demoCaption }}</p>
    </div>
  </div>
</section>

{# ══ 3 · PROOF STRIP ══ #}
<div class="proof">
  <div class="wide proof-in">
    <span class="proof-lbl">{{ strings.proof.label }}</span>
    {% for p in projects | visible %}<a class="proof-item" href="#work">{{ p.name }}</a>{% endfor %}
  </div>
</div>

{# ══ 4 · METHOD ══ #}
<section class="sec" id="method">
  <div class="wide">
    <div class="sec-head edge">
      <p class="label">{{ strings.pillars.label }}</p>
      <h2 class="d2">{{ strings.pillars.heading }}</h2>
      <p class="lead">{{ strings.pillars.lead }}</p>
    </div>
    <p class="governing"><b>{{ strings.pillars.governing }}</b></p>
    <div class="legend">
      <span class="chip chip-now">{{ strings.pillars.statusNow }}</span>
      <span class="chip chip-found">{{ strings.pillars.statusFoundation }}</span>
      <span class="chip chip-dev">{{ strings.pillars.statusDevelopment }}</span>
      <span class="chip chip-vision">{{ strings.pillars.statusVision }}</span>
    </div>
    <div class="pillars">
      {% for p in offer.pillars %}
      {% set s = strings.pillars[p.id] %}
      <article class="pillar">
        <p class="pillar-n">0{{ loop.index }}</p>
        <h3 class="d3">{{ s.title }}</h3>
        <p class="pillar-status">
          {% if p.status == "now" %}<span class="chip chip-now">{{ strings.pillars.statusNow }}</span>
          {% elif p.status == "foundation" %}<span class="chip chip-found">{{ strings.pillars.statusFoundation }}</span>
          {% elif p.status == "development" %}<span class="chip chip-dev">{{ strings.pillars.statusDevelopment }}</span>
          {% else %}<span class="chip chip-vision">{{ strings.pillars.statusVision }}</span>{% endif %}
        </p>
        <p>{{ s.body }}</p>
        {% if s.note %}<p class="pillar-note">{{ s.note }}</p>{% endif %}
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# ══ 5 · COMMERCIAL OFFER ══
   One approved figure, shown once. No pricing table, no second public tier. #}
<section class="sec" id="offer">
  <div class="wrap">
    <div class="sec-head edge">
      <p class="label">{{ strings.offer.label }}</p>
      <h2 class="d2">{{ strings.offer.heading }}</h2>
    </div>

    {# The thing you can buy gets the full measure and all the visual weight.
       The thing you cannot buy is a band underneath, not a second card. #}
    <div class="panel panel-now offer-lead">
      <span class="chip chip-now">{{ strings.pillars.statusNow }}</span>
      <h3 class="d3">{{ strings.offer.entryName }}</h3>
      <p class="lead offer-lead-line">{{ strings.offer.dfyLead }}</p>

      {% if offer.entry.public and offer.entry.priceApproved %}
      <p class="price">{{ strings.offer.startAt | replace("{price}", "₪" + (offer.entry.from | num(loc.code))) }}</p>
      <p class="sm offer-note">{{ strings.offer.qualifier }}</p>
      {% endif %}

      <p class="label" style="margin-block:26px 12px">{{ strings.offer.includesLabel }}</p>
      <ul class="inc inc-two">
        {% for k in offer.entry.includes %}
        <li><svg width="16" height="16" aria-hidden="true" focusable="false"><use href="#i-check"/></svg>{{ strings.offer.inc[k] }}</li>
        {% endfor %}
      </ul>

      {# Qualification sits directly beneath the eight inclusions: secondary,
         but at body size and body colour — never faint, never detached. #}
      <p class="sm offer-qualifier">{{ strings.offer.larger }}</p>

      <div class="offer-actions">
        {% if site.whatsapp %}
        <a class="btn btn-primary" href="{{ site.whatsapp | waLink(strings.contact.waPrefill) }}" rel="noopener">
          <svg width="18" height="18" aria-hidden="true" focusable="false"><use href="#i-wa"/></svg>{{ strings.offer.ctaWa }}</a>
        {% endif %}
        <a class="offer-brief-link" href="#brief">{{ strings.offer.ctaBrief }}</a>
      </div>
    </div>

    <aside class="roadmap-band" aria-label="{{ strings.offer.futureName }}">
      <span class="chip chip-dev">{{ strings.offer.futureStatus }}</span>
      <div>
        <p class="roadmap-band-name">{{ strings.offer.futureName }}</p>
        <p class="xs">{{ strings.offer.futureBody }} {{ strings.offer.futureNote }}</p>
      </div>
    </aside>
  </div>
</section>

{# ══ 6 · PROCESS ══ #}
<section class="sec">
  <div class="wide">
    <div class="sec-head edge">
      <p class="label">{{ strings.process.label }}</p>
      <h2 class="d2">{{ strings.process.heading }}</h2>
    </div>
    <div class="steps">
      {% for n in [1,2,3,4] %}
      <article class="step">
        <p class="step-n">0{{ n }}</p>
        <h3 class="d3">{{ strings.process["s" + n + "t"] }}</h3>
        <p>{{ strings.process["s" + n + "b"] }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# ══ 7 · SELECTED WORK ══ #}
<section class="sec" id="work">
  <div class="wide">
    <div class="sec-head edge" style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;max-inline-size:none">
      <div style="max-inline-size:40rem">
        <p class="label">{{ strings.work.label }}</p>
        <h2 class="d2">{{ strings.work.heading }}</h2>
        <p class="lead" style="margin-block-start:14px">{{ strings.work.lead }}</p>
      </div>
      <button class="showcase-btn" type="button" data-showcase-toggle
              aria-label="{{ strings.work.pauseMotion }}"
              data-label-play="{{ strings.work.playMotion }}"
              data-label-pause="{{ strings.work.pauseMotion }}">
        <svg class="mi-pause" width="15" height="15" viewBox="0 0 15 15" aria-hidden="true" focusable="false">
          <rect x="3" y="2" width="3.2" height="11" rx="1.1" fill="currentColor"/>
          <rect x="8.8" y="2" width="3.2" height="11" rx="1.1" fill="currentColor"/></svg>
        <svg class="mi-play" width="15" height="15" viewBox="0 0 15 15" aria-hidden="true" focusable="false">
          <path d="M4 2.6 12.4 7.5 4 12.4Z" fill="currentColor"/></svg>
      </button>
    </div>
  </div>
  {% include "components/showcase.njk" %}
</section>

{# ══ CAPABILITY BAND ══ #}
<section class="sec" id="capabilities">
  <div class="wide">
    <div class="sec-head edge">
      <p class="label">{{ strings.cap.label }}</p>
      <h2 class="d2">{{ strings.cap.heading }}</h2>
      <p class="lead" style="margin-block-start:14px">{{ strings.cap.lead }}</p>
    </div>
  </div>
  {% include "components/capability.njk" %}
</section>

{# ══ 8 · VISION / ROADMAP ══ #}
<section class="sec" id="vision">
  <div class="wide">
    <div class="sec-head edge">
      <p class="label">{{ strings.roadmap.label }}</p>
      <h2 class="d2">{{ strings.roadmap.heading }}</h2>
      <p class="lead">{{ strings.roadmap.lead }}</p>
    </div>
    <div class="roadmap">
      <div class="rm-step"><p class="rm-v">V10–V11</p><p class="rm-t">{{ strings.roadmap.v10 }}</p><p class="rm-s">{{ strings.roadmap.v10b }}</p></div>
      <div class="rm-step"><p class="rm-v">V12</p><p class="rm-t">{{ strings.roadmap.v12 }}</p><p class="rm-s">{{ strings.roadmap.v12b }}</p></div>
      <div class="rm-step"><p class="rm-v">V13</p><p class="rm-t">{{ strings.roadmap.v13 }}</p><p class="rm-s">{{ strings.roadmap.v13b }}</p></div>
      <div class="rm-step"><p class="rm-v">V14</p><p class="rm-t">{{ strings.roadmap.v14 }}</p><p class="rm-s">{{ strings.roadmap.v14b }}</p></div>
    </div>
  </div>
</section>

{# ══ 9 · TRUST AND OWNERSHIP ══ #}
<section class="sec">
  <div class="wide">
    <div class="sec-head edge">
      <p class="label">{{ strings.trust.label }}</p>
      <h2 class="d2">{{ strings.trust.heading }}</h2>
    </div>
    <div class="trust">
      {% for n in [1,2,3,4,5,6] %}
      <article class="tile">
        <svg width="22" height="22" aria-hidden="true" focusable="false"><use href="#i-check"/></svg>
        <h3>{{ strings.trust["t" + n] }}</h3>
        <p>{{ strings.trust["b" + n] }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{# ══ 10 · FAQ ══ #}
<section class="sec">
  <div class="wide">
    <div class="sec-head edge">
      <p class="label">{{ strings.faq.label }}</p>
      <h2 class="d2">{{ strings.faq.heading }}</h2>
    </div>
    <div class="faq">
      {% for n in [1,2,3,4,5,6,7,8,9] %}
      <details{% if loop.first %} open{% endif %}>
        <summary>{{ strings.faq["q" + n] }}</summary>
        <p>{{ strings.faq["a" + n] }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

{# ══ 11 · PROJECT BRIEF ══ #}
<section class="sec surface" id="brief">
  <div class="wrap">
    <div class="sec-head edge" style="text-align:center;margin-inline:auto">
      <p class="label">{{ strings.brief.label }}</p>
      <h2 class="d2">{{ strings.brief.heading }}</h2>
      <p class="lead" style="margin-inline:auto">{{ strings.brief.lead }}</p>
    </div>
    <form class="brief" id="briefForm" novalidate>
      <span class="chip chip-preview">{{ strings.brief.previewChip }}</span>
      <div class="prog" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      <p class="label" style="margin-block-end:14px">{{ strings.brief.step }}</p>
      <label class="d3" for="b1">{{ strings.brief.q1 }}</label>
      <textarea id="b1" name="business" rows="4" placeholder="{{ strings.brief.placeholder }}"></textarea>
      <p class="err" data-show="0" role="status" aria-live="polite"
         data-empty="{{ strings.brief.errEmpty }}" data-short="{{ strings.brief.errShort }}"
         data-disabled="{{ strings.brief.disabled }}"></p>
      <div class="brief-row">
        <button class="btn btn-muted" type="submit" aria-describedby="briefSubmitNote">{{ strings.brief.continue }}</button>
        <span class="xs" id="briefSubmitNote">{{ strings.brief.submitNote }}</span>
      </div>
      <p class="brief-privacy">{{ strings.brief.privacy }}</p>
    </form>
    <div class="alt">
      {% set wa2 = site.whatsapp | waLink(strings.contact.waPrefill) %}
      {% if wa2 %}
        <a class="btn btn-ghost" href="{{ wa2 }}" rel="noopener">
          <svg width="19" height="19" aria-hidden="true" focusable="false"><use href="#i-wa"/></svg>{{ strings.brief.altWhatsapp }}</a>
      {% else %}
        <span class="inert"><svg width="19" height="19" aria-hidden="true" focusable="false"><use href="#i-wa"/></svg>{{ strings.brief.altWhatsapp }} — {{ strings.brief.unavailable }}</span>
      {% endif %}
      {% if site.email %}
        <a class="btn btn-ghost" href="mailto:{{ site.email }}">{{ strings.contact.email }}</a>
      {% endif %}
      {% if site.schedulerUrl %}
        <a class="btn btn-ghost" href="{{ site.schedulerUrl }}" rel="noopener">{{ strings.brief.altConsult }}</a>
      {% else %}
        <span class="inert">{{ strings.brief.altConsult }} — {{ strings.brief.unavailable }}</span>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}
{# One deliberate brand moment, pre-footer. The only place the Threshold mark
   is large enough for the chamfer and the incision to be legible. #}
<section class="sec" aria-labelledby="brandMomentName" style="padding-block-end:0">
  <div class="wrap brand-moment">
    <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false"><use href="#mark"/></svg>
    <div class="brand-moment-copy">
      <p class="brand-moment-name" id="brandMomentName">{{ strings.brand.name }}</p>
      <p class="sm">{{ strings.brand.line }}</p>
    </div>
  </div>
</section>

